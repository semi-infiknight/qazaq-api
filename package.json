{
  "name": "qazaq-stack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev:verify": "bash scripts/dev-verify.sh",
    "build": "vite build && npx playwright install chromium && node scripts/generate-og.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "embed:build": "node scripts/build-api-embeddings.mjs && node scripts/build-feature-embeddings.mjs",
    "embed:features": "node scripts/build-feature-embeddings.mjs",
    "cap:build": "node scripts/build-api-capability-matrix.mjs",
    "cap:audit": "node scripts/audit-feature-map.mjs",
    "cap:report": "node scripts/print-capability-report.mjs",
    "suggest:eval": "node scripts/test-suggest-eval.mjs",
    "suggest:bench": "node scripts/benchmark-startup-intents.mjs --limit 10000 --full",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.51.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
